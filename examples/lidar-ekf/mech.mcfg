config := {
  hosts: [
    {
      name: "front"
      provider: "lidar"
      settings: {
        port: "/dev/ttyUSB0"
        baud: 115200
        interval-ms: 100
        points-per-scan: 360
      }
    }
    { name: "console" provider: "console" settings: {} }
  ]

  run: {
    paths: ["ekf-lidar.mec"]

    grants: [
      {
        target: "front/scan"
        operations: ["read"]
        paths: ["scan-id", "sector-0-range", "sector-4-range", "sector-8-range", "sector-12-range"]
      }
      {
        target: "console/output"
        operations: ["write"]
        paths: ["line"]
      }
    ]
  }
}
