+> math

@out := console://console/output{:write(line)}

@scan := lidar://front/scan{:read(scan-id), :read(sector-0-range), :read(sector-4-range), :read(sector-8-range), :read(sector-12-range)}

sid := @scan/scan-id
r0  := @scan/sector-0-range
r4  := @scan/sector-4-range
r8  := @scan/sector-8-range
r12 := @scan/sector-12-range

readout := [sid r0 r4 r8 r12]

@out/line <- readout
